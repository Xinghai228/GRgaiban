<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/base_title" />
    <TabHost android:id="@id/tab_settings" android:layout_width="fill_parent" android:layout_height="fill_parent"
      xmlns:android="http://schemas.android.com/apk/res/android">
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent" android:baselineAligned="false">
            <ScrollView android:id="@id/sv_tabs" android:scrollbars="none" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_weight="32.0">
                <TabWidget android:orientation="vertical" android:id="@android:id/tabs" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            </ScrollView>
            <ScrollView android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_weight="10.0">
                <FrameLayout android:id="@android:id/tabcontent" android:padding="12.0dip" android:layout_width="fill_parent" android:layout_height="wrap_content" />
            </ScrollView>
        </LinearLayout>
    </TabHost>
</LinearLayout>
